{
  "expo": {
    "name": "Noctívago",
    "slug": "noctivago-mobile",
    "version": "0.19.14",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.venarihunt.noctivago"
    },
    "android": {
      "package": "io.github.venarihunt.noctivago",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/octet-stream"
            },
            {
              "scheme": "file",
              "mimeType": "application/octet-stream"
            },
            {
              "scheme": "content",
              "mimeType": "application/zip"
            },
            {
              "scheme": "file",
              "mimeType": "application/zip"
            },
            {
              "scheme": "content",
              "mimeType": "application/x-zip-compressed"
            },
            {
              "scheme": "file",
              "mimeType": "application/x-zip-compressed"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "file",
              "host": "*",
              "pathPattern": ".*\\.ncvpreset"
            },
            {
              "scheme": "file",
              "host": "*",
              "pathPattern": ".*\\..*\\.ncvpreset"
            },
            {
              "scheme": "file",
              "host": "*",
              "pathPattern": ".*\\..*\\..*\\.ncvpreset"
            },
            {
              "scheme": "content",
              "host": "*",
              "pathPattern": ".*\\.ncvpreset"
            },
            {
              "scheme": "content",
              "host": "*",
              "pathPattern": ".*\\..*\\.ncvpreset"
            },
            {
              "scheme": "content",
              "host": "*",
              "pathPattern": ".*\\..*\\..*\\.ncvpreset"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "audio/*"
            },
            {
              "scheme": "file",
              "mimeType": "audio/*"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "iosMicrophonePermission": "Noctívago records sounds with the microphone when you tap Record.",
          "androidForegroundService": true,
          "androidFSTypes": [
            "mediaPlayback"
          ],
          "androidPermissions": [
            "android.permission.MODIFY_AUDIO_SETTINGS",
            "android.permission.FOREGROUND_SERVICE",
            "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
            "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
          ]
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "application/octet-stream",
              "application/zip",
              "application/x-zip-compressed",
              "audio/*"
            ],
            "multipleShareMimeTypes": [
              "audio/*"
            ]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "aa7d1962-ef66-48be-aa68-e0fecd3d54e0"
      }
    },
    "owner": "venari-hunt",
    "updates": {
      "url": "https://u.expo.dev/aa7d1962-ef66-48be-aa68-e0fecd3d54e0"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "scheme": "noctivago"
  }
}
